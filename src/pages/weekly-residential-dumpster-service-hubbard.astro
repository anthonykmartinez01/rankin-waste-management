---
// src/pages/weekly-residential-dumpster-service-hubbard.astro
//
// Weekly residential dumpster service (2-yard container that stays at the
// home and is emptied weekly). New service launched 2026-09. Follows the
// /dumpster-rental-service-hubbard layout: InnerHero + max-w-[1300px]
// container + data-reveal sections + ReviewWidget + CTA box with the
// "New Service Request" modal trigger. Adds a FAQ block (FaqAccordion +
// FAQPage schema) built from one array so visible Q/A and schema match.
//
// Sizes: 2, 3, 4 and 6 yards (see SIZES). PHOTOS REMOVED 2026-09-29 at the
// client's request until photos of every size arrive. The 2-yard photos
// still exist (public/images/services/weekly-dumpster*.webp = 3:2 hero,
// public/images/weekly-dumpster/{garage,driveway}*.webp = 4:3 rows) and
// can be restored as the hero bgImage, the size-section image, and the
// image-left row in "Why Rankin".
//
// Copy rules: no stated dimensions (unverified), no claims about how the
// truck empties them.
//
// Copy rule for this page: no em dashes anywhere in visible copy, meta,
// or schema text (client preference).
//
// Schema: Service (provider LocalBusiness with aggregateRating + reviews
// nested under provider, same rich-result fix as the sibling pages) +
// BreadcrumbList + FAQPage.
import Layout from '../layouts/Layout.astro';
import InnerHero from '../components/InnerHero.astro';
import CallCTA from '../components/CallCTA.astro';
import ReviewWidget from '../components/ReviewWidget.tsx';
import FaqAccordion from '../components/FaqAccordion.tsx';
import type { Faq } from '../data/faqs';
import { PHONE, PHONE_LINK } from '../data/business';

const PAGE_URL = 'https://rankinwaste.com/weekly-residential-dumpster-service-hubbard';

// Sizes offered (client confirmed 2026-09-29: 2, 3, 4 and 6 yards).
// Capacity figures are straight conversions, not hauler specs:
//   1 cubic yard = ~202 gallons; carts = standard 96-gallon trash cart
//   (rounded down). No bag-count equivalents (client removed them
//   2026-09-29). Do NOT add dimensions per size; the 3/4/6-yard "fits" lines
//   are deliberately non-dimensional.
// Every size HAS A LID (client confirmed 2026-09-29). Never describe them
// as open-top, low-profile, or "no lid to lift". The shared Style line
// lives in the card template below.
// PRICING (client, 2026-10-01): the client does NOT know the billing period
// (per week vs per month) or whether any area costs more. So prices are
// shown exactly as given ("$92 + tax") with NO period, and every pricing
// mention is paired with "confirm the rate and billing schedule for your
// address". Never add "per month"/"per week"/"same price everywhere" until
// the client confirms.
const SIZES = [
  { yards: 2, price: 92, gallons: '400', carts: 'four', fits: 'In most driveways or beside a garage' },
  { yards: 3, price: 120, gallons: '600', carts: 'six', fits: "Takes a little more room than the 2-yard. We'll confirm your spot before drop-off" },
  { yards: 4, price: 142, gallons: '800', carts: 'eight', fits: "Takes more room than the smaller sizes. We'll confirm your spot before drop-off" },
  { yards: 6, price: 172, gallons: '1,200', carts: 'twelve', fits: "Our largest size, so it needs the most room. We'll confirm your spot before drop-off" },
];
const STARTING_PRICE = Math.min(...SIZES.map((s) => s.price));

const SIGNS = [
  { title: 'Your cart is full before pickup day', body: "If the lid won't close by midweek, you're stuffing bags in the garage or paying for a second cart. Even our smallest 2-yard dumpster holds about four carts' worth." },
  { title: 'You have a big household', body: 'More people means more diapers, more takeout boxes, more of everything. A weekly dumpster keeps up without you rationing space.' },
  { title: 'You live on acreage', body: 'Rural properties just make more trash: feed sacks, shop scraps, bagged yard waste, and the odds and ends that pile up around a barn.' },
  { title: "You're fixing up the house a little at a time", body: 'Slow remodels make steady trash week after week. A dumpster that gets emptied on schedule handles that better than a one-time rental.' },
  { title: 'More than one home shares the lot', body: 'A rent house, guest house, or family place on the same property can share one dumpster instead of lining up several carts at the road.' },
  { title: 'Hauling a cart to the road is a chore', body: 'The dumpster stays put on your property, so you never drag a cart down a long driveway again.' },
];

const STEPS = [
  { title: 'Call or text us', body: "Tell us your address and roughly how much trash your household makes. We'll confirm our truck can reach your spot and give you a flat-rate quote right on the phone." },
  { title: 'We set your dumpster', body: "We'll pick a flat, level spot together, usually near the driveway or garage, with clear room for our truck to get in and back out." },
  { title: 'We empty it every week', body: "Your dumpster gets emptied on your scheduled day, every week. Just keep the area around it clear so our truck can get to it, and you're done." },
];

const FAQS: Faq[] = [
  { q: 'What size dumpster does a Hubbard home need?', a: "Most Hubbard homes that outgrow a single trash cart do fine with a 2-yard dumpster, which holds about four carts' worth of trash. Bigger households, rural properties, and lots with more than one home often need a 3-, 4-, or 6-yard, which hold about six, eight, or twelve carts' worth. Tell us how much trash your household makes and we'll help you pick the right size." },
  { q: 'Is a weekly dumpster worth it over a regular trash cart in Hubbard?', a: "A weekly dumpster is worth it in Hubbard if your cart is full before pickup day most weeks. Instead of paying for extra carts or stacking bags by the road, you get one container with at least four times the room. If your cart usually has space left over, our regular weekly pickup is the simpler choice." },
  { q: 'How much does a weekly dumpster cost in Hubbard?', a: "A weekly residential dumpster in Hubbard starts at $92 + tax for a 2-yard. A 3-yard is $120 + tax, a 4-yard is $142 + tax, and a 6-yard is $172 + tax. Call (254) 205-6125 to confirm the rate and billing schedule for your address." },
  { q: 'Do I have to sign a contract for dumpster service in Hubbard?', a: "No, you don't have to sign a contract for dumpster service in Hubbard with us. There are no long-term agreements and no cancellation fees. If your needs change, call (254) 205-6125 and we'll adjust or cancel your service." },
  { q: "What can't go in a residential dumpster in Hubbard?", a: "Texas law keeps a few items out of any regular trash in Hubbard, residential dumpsters included: car batteries, used motor oil, used oil filters, whole tires, and refrigerators, freezers, or AC units that still have refrigerant in them. Paint, pesticides, and harsh chemicals need special handling too. When in doubt, call us before you toss it." },
  { q: 'Can I get a weekly dumpster outside Hubbard city limits?', a: "In most cases, yes, you can get a weekly dumpster outside Hubbard city limits. We already run routes across the rural areas around Hubbard. The main thing we need is a spot our truck can safely reach. Call (254) 205-6125 with your address and we'll confirm." },
  { q: 'Should I get a weekly dumpster or a dump trailer for a cleanout in Hubbard?', a: "For a one-time cleanout in Hubbard, a dump trailer is usually the better pick. It holds about 14 cubic yards and leaves when the job is done. A weekly dumpster is built for steady, everyday household trash that keeps coming week after week." },
];
---

<Layout
  title="Weekly Residential Dumpster Service Hubbard TX | Rankin Waste"
  description="Weekly residential dumpster service in Hubbard, TX and surrounding counties. Four sizes from $92 + tax, emptied weekly. Call (254) 205-6125."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": `${PAGE_URL}/#service`,
      "name": "Weekly Residential Dumpster Service in Hubbard, TX",
      "description": "A 2, 3, 4, or 6 cubic yard residential dumpster placed at your home in Hubbard and emptied every week. Built for households that outgrow a standard trash cart: big families, rural properties, ongoing home projects, and shared lots. Family-owned, flat-rate pricing, no contracts.",
      "serviceType": "Residential Dumpster Service",
      "category": "Weekly Residential Dumpster Service",
      "url": PAGE_URL,
      "provider": {
        "@type": "LocalBusiness",
        "@id": "https://rankinwaste.com/#business",
        "name": "Rankin Waste Management",
        "telephone": "+1-254-205-6125",
        "email": "rankinwaste@gmail.com",
        "url": "https://rankinwaste.com/",
        "image": "https://rankinwaste.com/rw-logo.webp",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "175 PR335",
          "addressLocality": "Hubbard",
          "addressRegion": "TX",
          "postalCode": "76648",
          "addressCountry": "US"
        },
        "priceRange": "$$",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
