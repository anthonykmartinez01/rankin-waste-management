---
// src/components/AnnouncementBanner.astro
//
// Sitewide promo bar. Rendered as the first row of the fixed header stack in
// Nav.astro, so it stays pinned with the nav instead of scrolling away.
//
// HEIGHT CONTRACT: the bar is exactly h-11 (44px, also the site's minimum
// tap-target size). Layout.astro pads <main> by the same pt-11 while the
// banner is enabled so hero content still clears the taller fixed header.
// If you change the height here, change that padding to match.
//
// Must stay on ONE line at every width or the height contract breaks:
// phones get the short label, `truncate` is the last-resort safety net.
import { announcement } from '../data/announcement';
---

{announcement.enabled && (
  <a
    href={announcement.href}
    class="group flex h-11 w-full items-center justify-center gap-2.5 bg-orange-500 px-4 text-sm font-semibold text-white transition-colors duration-300 hover:bg-orange-600"
  >
    <span class="shrink-0 rounded-full bg-dark px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-orange-300">New</span>
    <span class="truncate">
      <span class="sm:hidden">{announcement.shortLabel}</span>
      <span class="hidden sm:inline">{announcement.label}</span>
    </span>
    <span class="hidden shrink-0 text-white/85 underline-offset-2 group-hover:underline sm:inline">{announcement.cta}</span>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor" class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
    </svg>
  </a>
)}
